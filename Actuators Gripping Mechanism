# Required Libraries:
# pip install gpiozero pigpio

from gpiozero.pins.pigpio import PiGPIOFactory
from gpiozero import AngularServo
from time import sleep

f = PiGPIOFactory()
r = AngularServo(12, min_pulse_width=0.0006, max_pulse_width=0.0023, pin_factory=f)
l = AngularServo(13, min_pulse_width=0.0006, max_pulse_width=0.0023, pin_factory=f)

while True:
    r.angle, l.angle = -90, 90
    sleep(2)
    r.angle = l.angle = 0
    sleep(2)
