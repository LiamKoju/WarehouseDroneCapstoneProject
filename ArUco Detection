# Required Libraries:
# pip install opencv-contrib-python numpy picamera2

import cv2
import numpy as np
import time
from picamera2 import Picamera2

arucoDict = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_6X6_100)
arucoParams = cv2.aruco.DetectorParameters_create()

camera_matrix = np.array([[800, 0, 320], [0, 800, 240], [0, 0, 1]], dtype=np.float32)
dist_coeffs = np.zeros((4, 1))

axis_length = 0.05
axis_points = np.float32([
    [0, 0, 0],
    [axis_length, 0, 0],
    [0, axis_length, 0],
    [0, 0, axis_length]
]).reshape(-1, 3)

def aruco_display(corners, ids, image):
    if ids is not None:
        ids = ids.flatten()
        for markerCorner, markerID in zip(corners, ids):
            corners = markerCorner.reshape((4, 2)).astype(int)
            cv2.polylines(image, [corners], True, (0, 255, 0), 2)

            cX, cY = np.mean(corners, axis=0).astype(int)
            cv2.putText(image, str(markerID), (corners[0][0], corners[0][1] - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

            rvec, tvec, _ = cv2.aruco.estimatePoseSingleMarkers(markerCorner, axis_length, camera_matrix, dist_coeffs)
            img_points, _ = cv2.projectPoints(axis_points, rvec, tvec, camera_matrix, dist_coeffs)
            img_points = img_points.astype(int)

            cv2.line(image, tuple(img_points[0].ravel()), tuple(img_points[1].ravel()), (0, 0, 255), 3)
            cv2.line(image, tuple(img_points[0].ravel()), tuple(img_points[2].ravel()), (0, 255, 0), 3)
            cv2.line(image, tuple(img_points[0].ravel()), tuple(img_points[3].ravel()), (255, 0, 0), 3)

            print(f"[Inference] ArUco marker ID: {markerID}")
    return image

try:
    picam2 = Picamera2()
    config = picam2.create_preview_configuration(main={"size": (640, 480)})
    picam2.configure(config)
    picam2.start()
    time.sleep(2)

    while True:
        frame = picam2.capture_array()
        frame = cv2.cvtColor(frame, cv2.COLOR_RGBA2BGR)

        h, w, _ = frame.shape
        scale = 800 / w
        img = cv2.resize(frame, (800, int(h * scale)), interpolation=cv2.INTER_CUBIC)

        corners, ids, _ = cv2.aruco.detectMarkers(img, arucoDict, parameters=arucoParams)
        detected_markers = aruco_display(corners, ids, img)

        cv2.imshow("ArUco Detection with XYZ Axis", detected_markers)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

except KeyboardInterrupt:
    print("Exiting program...")

except Exception as e:
    print(f"An error occurred: {e}")

finally:
    cv2.destroyAllWindows()
    picam2.stop()
    picam2.close()
